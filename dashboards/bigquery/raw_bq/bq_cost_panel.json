            ],
            "type": "column"
          }
        ]
      ],
      "timeColumn": "-- time --",
      "timeColumnType": "TIMESTAMP",
      "where": [
        {
          "name": "$__timeFilter",
          "params": [],
          "type": "macro"
        }
      ]
    }
  ],
  "title": "BQ Cost by account",
