      "rawQuery": true,
      "rawSql": "SELECT\n  user_email,\n  sum(total_bytes_processed / 1000000000000)*6.75 as cost_usd,\n  AVG(SAFE_DIVIDE(total_slot_ms,(TIMESTAMP_DIFF(end_time, start_time, MILLISECOND)))) AS avg_slots,\n  MIN(SAFE_DIVIDE(total_slot_ms,(TIMESTAMP_DIFF(end_time, start_time, MILLISECOND)))) AS min_slots,\n  MAX(SAFE_DIVIDE(total_slot_ms,(TIMESTAMP_DIFF(end_time, start_time, MILLISECOND)))) AS max_slots\n  FROM\n  `region-asia-southeast1`.INFORMATION_SCHEMA.JOBS_BY_PROJECT jbo\n  WHERE\n  $__timeFilter(creation_time)\n  GROUP BY 1\n  ORDER BY\n     cost_usd DESC\n",
      "refId": "A",
